# =============================================================================
# CITY STAR HOTEL - API ENVIRONMENT CONFIGURATION (.env.example)
# Duplicate this file to .env and supply actual production/development credentials
# =============================================================================

# Server Deployment (Render Port defaults to 10000 or process.env.PORT)
PORT=10000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=https://citystaraccomodation.onrender.com,http://localhost:3000,http://localhost:5173

# Supabase Infrastructure Target: https://eyxorfozdtpysnsdwkib.supabase.co
SUPABASE_URL=https://eyxorfozdtpysnsdwkib.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_for_client_access
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key_for_admin_and_worker_operations
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# PostgreSQL Database Connection Strings
# Supabase Transaction Pooler (Port 6543 via Supavisor / PgBouncer - Best for Render serverless & web instances)
DATABASE_URL=postgresql://postgres.eyxorfozdtpysnsdwkib:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10

# Direct Database URL (Port 5432 - Required for Prisma schema migrations and DDL execution)
DIRECT_URL=postgresql://postgres.eyxorfozdtpysnsdwkib:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
